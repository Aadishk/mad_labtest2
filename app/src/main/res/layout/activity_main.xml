<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg"
    tools:context=".MainActivity">

    <!-- Top App Header Bar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_shield" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/ios_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subtitle_trip"
                android:textColor="@color/ios_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content Container for Tab Views -->
    <FrameLayout
        android:id="@+id/containerContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCard"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <!-- VIEW 1: Emergency Contacts View -->
        <LinearLayout
            android:id="@+id/viewEmergency"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingVertical="8dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="@color/ios_red" />

                <TextView
                    android:id="@+id/tvEmergencyHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/emergency_section_title"
                    android:textColor="@color/ios_red"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card Container for Emergency Contacts ListView -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_emergency_card"
                android:orientation="vertical"
                android:padding="4dp">

                <!-- Empty state when no emergency contacts -->
                <TextView
                    android:id="@+id/tvEmptyEmergency"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/no_emergency_contacts"
                    android:textColor="@color/ios_text_secondary"
                    android:textSize="14sp" />

                <!-- ListView for Emergency Contacts -->
                <ListView
                    android:id="@+id/lvEmergencyContacts"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@color/ios_stroke"
                    android:dividerHeight="1dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- VIEW 2: All Phone Contacts View -->
        <LinearLayout
            android:id="@+id/viewContacts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Search Box widget -->
            <EditText
                android:id="@+id/etSearchContact"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:autofillHints="name"
                android:background="@drawable/bg_ios_search"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="textPersonName"
                android:paddingHorizontal="14dp"
                android:textColor="@color/ios_text_primary"
                android:textColorHint="@color/ios_text_secondary"
                android:textSize="15sp" />

            <!-- All Contacts Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingVertical="6dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="@color/ios_blue" />

                <TextView
                    android:id="@+id/tvAllContactsHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/all_contacts_section_title"
                    android:textColor="@color/ios_text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card Container for All Contacts ListView -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ios_card"
                android:orientation="vertical"
                android:padding="4dp">

                <!-- Permission prompt layout if needed -->
                <LinearLayout
                    android:id="@+id/layoutPermission"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/permission_contacts_required"
                        android:textColor="@color/ios_text_secondary"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantPermission"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/ios_blue"
                        android:text="@string/grant_permission"
                        android:textColor="@color/white"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <!-- Empty state when search returns no result -->
                <TextView
                    android:id="@+id/tvEmptyAllContacts"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="@string/no_contacts_found"
                    android:textColor="@color/ios_text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- ListView for All Phone Contacts -->
                <ListView
                    android:id="@+id/lvAllContacts"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@color/ios_stroke"
                    android:dividerHeight="1dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Navigation Bar Card (iOS Floating Pill Style) -->
    <LinearLayout
        android:id="@+id/bottomNavCard"
        android:layout_width="wrap_content"
        android:layout_height="64dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Tab 1: Emergency Contacts -->
        <LinearLayout
            android:id="@+id/tabEmergency"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_tab_selected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp">

            <ImageView
                android:id="@+id/ivTabEmergencyIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/tab_emergency"
                android:src="@drawable/ic_call"
                app:tint="@color/ios_red" />

            <TextView
                android:id="@+id/tvTabEmergencyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_emergency"
                android:textColor="@color/ios_red"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 2: Contacts Picker -->
        <LinearLayout
            android:id="@+id/tabContacts"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp">

            <ImageView
                android:id="@+id/ivTabContactsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/tab_contacts"
                android:src="@drawable/ic_contacts"
                app:tint="@color/ios_text_secondary" />

            <TextView
                android:id="@+id/tvTabContactsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_contacts"
                android:textColor="@color/ios_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>